# =============================================================================
# ZIN ZOO Backend - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git. NEVER put real credentials in this file.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=your_mongodb_connection_string_here
# Example format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_access_secret_here_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_minimum_32_chars
# Tip: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Payment ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Cloud Storage ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=noreply@yourdomain.com

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=your_firebase_service_account_json_here
FIREBASE_DATABASE_URL=your_firebase_database_url_here
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# ── Redis / BullMQ (optional) ─────────────────────────────────────────────────
REDIS_ENABLED=false
BULLMQ_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ── GitHub Deploy Webhook ─────────────────────────────────────────────────────
DEPLOY_WEBHOOK_SECRET=your_github_webhook_secret_here

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── Twilio OTP (if used) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here

# ── Admin Seeding (for scratch scripts only) ──────────────────────────────────
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=set_a_strong_password_here
# ADMIN_NAME=Admin Name
