# ==============================================================================
# ZIN ZOO Master .gitignore
# ==============================================================================

# ── Environment Variables (NEVER commit) ─────────────────────────────────────
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Logs & Debugging ──────────────────────────────────────────────────────────
logs/
*.log
*/logs/

# ── Scratch & Script Files (Testing/Hardcoded data) ───────────────────────────
scratch/
scripts/
scratch_files/
*/scratch/
Backend/scratch/
*/scripts/
*/scratch_files/

# Specific Test Files
Frontend/src/modules/Food/utils/backendConnectionTest.js
Backend/src/api/v1/test

# Admin Testing & Scratch Scripts
Backend/src/modules/food/admin/test_save.js
Backend/src/modules/food/admin/check_indexes.js
Backend/src/modules/food/admin/drop_index.js
Backend/src/modules/food/admin/scratch_check_db.js
Backend/src/modules/food/admin/scratch_check_wallet_coins.js
Backend/src/modules/food/admin/set_zero_quantity.js
Backend/src/modules/food/admin/update_existing_quantities.js
Backend/src/modules/food/admin/verify_deduct.js

# ── Build Outputs ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
coverage/
*/dist/
*/dist-ssr/
*/coverage/

# ── Vite ──────────────────────────────────────────────────────────────────────
*.timestamp-*
*.local

# ── Uploads & User Generated Content ──────────────────────────────────────────
uploads/
*/uploads/

# ── Editor Directories and Files ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── Custom / Temporary Build & Deploy Scripts ─────────────────────────────────
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

# ── Agent System Files ────────────────────────────────────────────────────────
.agents/

# ── Markdown files (as requested) ─────────────────────────────────────────────
*.md